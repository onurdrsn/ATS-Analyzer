# PostgreSQL Database
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_super_secret_password_change_me
POSTGRES_DB=ats_db

# Core ATS API
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
RESEND_API_KEY=your_resend_api_key_here

# Frontend URL (For CORS and Email Links)
ALLOWED_ORIGIN=http://localhost:5173

# Cloudflare Workers AI (For Skill Extraction and Gap Fixes)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_WORKERS_AI_TOKEN=your_cloudflare_workers_ai_token

# Optional: Self-Hosted LLM Fallback (e.g. Local Ollama)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenTelemetry (disabled by default — opt-in for observability)
# Set OTEL_ENABLED=true and run `make docker-up-observability` to enable SigNoz tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
